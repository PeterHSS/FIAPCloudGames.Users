{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "User": "",
        "RabbitMQ": "host=localhost;username=rabbitmq;password=rabbitmq"
    },
    "Jwt": {
        "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
        "Issuer": "fiap-cloud-games",
        "Audience": "developers",
        "ExpirationInMinutes": 15
    },
    "GameApi": {
        "BaseAddress": "http://fiapcloudgames-games-api.fgc.svc.cluster.local:80/"
    },
    "OrderApi": {
        "BaseAddress": "http://fiapcloudgames-orders-api.fgc.svc.cluster.local:80/"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.OpenSearch"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Error",
                "Microsoft": "Error",
                "System": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "restrictToMinimumLevel": "Information"
                }
            },
            {
                "Name": "OpenSearch",
                "Args": {
                    "nodeUris": "https://localhost:9200",
                    "indexFormat": "fgc-users-api-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "restrictedToMinimumLevel": "Information"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "FIAPCloudGames.Users.Api.Development"
        }
    }
}