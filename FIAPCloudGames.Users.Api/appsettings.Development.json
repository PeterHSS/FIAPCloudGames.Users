{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "User": "Host=rdp-fgc.corya2mk640h.us-east-1.rds.amazonaws.com;Port=5432;User Id=postgres;Password=postgres;Database=fgc;",
        "RabbitMQ": "host=localhost;username=rabbitmq;password=rabbitmq"
    },
    "Jwt": {
        "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
        "Issuer": "fiap-cloud-games",
        "Audience": "developers",
        "ExpirationInMinutes": 15
    },
    "GameApi": {
        "BaseAddress": "http://fiapcloudgames-games-api.fgc.svc.cluster.local:80/"
    },
    "OrderApi": {
        "BaseAddress": "http://fiapcloudgames-orders-api.fgc.svc.cluster.local:80/"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Elasticsearch"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Error",
                "Microsoft": "Error",
                "System": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "restrictToMinimumLevel": "Information"
                }
            },
            {
                "Name": "Elasticsearch",
                "Args": {
                    "nodeUris": "http://localhost:9200",
                    "indexFormat": "fgc-users-api-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "restrictedToMinimumLevel": "Information"
                }
            }
        ],
        "Enrich": [ "FromLogContext" ],
        "Properties": {
            "Application": "FIAPCloudGames.Users.Api.Development"
        }
    },
    "Elasticsearch": {
        "Uri": "http://localhost:9200"
    }
}