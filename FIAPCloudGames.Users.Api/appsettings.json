{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "User": "",
        "RabbitMQ": ""
    },
    "Jwt": {
        "Secret": "",
        "Issuer": "",
        "Audience": "",
        "ExpirationInMinutes": ""
    },
    "GameApi": {
        "BaseAddress": "http://fiapcloudgames-games-api.fgc.svc.cluster.local:80/"
    },
    "OrderApi": {
        "BaseAddress": "http://fiapcloudgames-orders-api.fgc.svc.cluster.local:80/"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.OpenSearch"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Error",
                "Microsoft": "Error",
                "System": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "restrictToMinimumLevel": "Information"
                }
            },
            {
                "Name": "OpenSearch",
                "Args": {
                    "nodeUris": "",
                    "indexFormat": "fgc-users-api-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "restrictedToMinimumLevel": "Information"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "FIAPCloudGames.Users.Api.Development"
        }
    },
    "Email": {
        "Sender": "",
        "SenderEmail": "",
        "Host": "",
        "Port": "",
        "Username": "",
        "Password": ""
    },
    "Opensearch": {
        "Username": "",
        "Password": ""
    }
}
